server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Use the container DNS resolver so .railway.internal hostnames are resolved
    # at request time (not startup), supporting Railway's IPv6 private networking.
    # NGINX_RESOLVER is set by the entrypoint script from /etc/resolv.conf.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;

    # Serve the SPA — any unknown path falls back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy the token endpoint through the same origin to avoid CORS issues
    # with confidential client (Authorization: Basic) token requests.
    location /token {
        set $curity_upstream "${CURITY_SCHEME}://${CURITY_HOST}:${CURITY_PORT}";
        proxy_pass $curity_upstream/oauth/v2/oauth-token;
        proxy_ssl_server_name on;
        proxy_ssl_verify off;
        proxy_set_header Host ${CURITY_PUBLIC_HOST};
    }

    # API calls: phantom token module exchanges the opaque access token for a
    # JWT by calling Curity's introspection endpoint, then forwards the JWT
    # as the Bearer token to the upstream API.
    location /api/ {
        phantom_token on;
        phantom_token_introspection_endpoint curity;

        set $api_upstream "${API_SCHEME}://${API_HOST}:${API_PORT}";
        proxy_pass $api_upstream;
        proxy_ssl_server_name on;
        proxy_ssl_verify off;
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Introspection subrequest location used by the phantom token module.
    # proxy_pass_request_headers off is required to prevent the original
    # Authorization: Bearer header from overriding the Basic auth credential.
    location curity {
        internal;
        set $curity_upstream "${CURITY_SCHEME}://${CURITY_HOST}:${CURITY_PORT}";
        proxy_pass_request_headers off;
        proxy_set_header Host ${CURITY_PUBLIC_HOST};
        proxy_set_header Accept "application/jwt";
        proxy_set_header Content-Type "application/x-www-form-urlencoded";
        proxy_set_header Authorization "Basic ${GATEWAY_CREDENTIAL}";
        proxy_pass $curity_upstream/oauth/v2/oauth-introspect;
        proxy_ssl_server_name on;
        proxy_ssl_verify off;
    }
}
